# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
venv_*/
.venv/
env/

# Django
*.log
# ...except rescued suite evidence. §AG5(c): the bare *.log above silently
# dropped two of the twelve records d4f93e0 claimed to rescue, and git add
# reported nothing. Measured before narrowing this: *.log currently excludes 82
# files, 80 of which are bbrose_design_os/webNN.log runserver logs, so the rule
# is doing real work and is NOT removed -- only this one evidence directory is
# re-included. A negation is used rather than `git add -f` because a forced add
# leaves no record of why the rule was bypassed, and the next person to drop a
# .log here would lose it in the same silence.
!bbrose_design_os/docs/roadmap/palt_m6/suite_records/*.log
db.sqlite3
db.sqlite3-journal
local_settings.py

# Secrets / local config
.env
.env.*
!.env.example

# Media & generated artifacts (recreated at runtime / by seed commands)
media/
exports/

# Stale duplicate project — superseded by bbrose_design_os/apps/dielines.
# Its design docs were moved to bbrose_design_os/apps/dielines/docs/ (Milestone 9.4).
# The directory itself should be deleted; ignored here in case deletion is
# blocked by filesystem permissions on a given machine.
dieline-generator/

# Test & tooling caches
.pytest_cache/
.coverage
htmlcov/

# Claude / editor / OS cruft
.claude/
.DS_Store
.idea/
.vscode/
*.swp

# Backups (Milestone 14.3) — dumps/tars live on the host, shipped off-site
backups/

# Reference design sources (70MB of production .ai files) — imported into
# media/references/ via `manage.py import_design_references design_models/`
design_models/

# Design Intelligence source library (28GB of historical .ai, assets, fonts).
# READ-ONLY source material — never committed, never modified. See tools/dip0/.
materials/

# Generated audit / intelligence outputs (regenerable from materials/)
var/

# §BH43(c) THE VAULT — generated markdown, derived and disposable: a rebuild
# reproduces it byte-for-byte, so it is remade for nothing and is not tracked.
/brain_vault/
/brain_vault.new/

# The clean-up of 2026-10-04: archive/ holds history the register cites (the executor's old work folders, Desktop
# reports), moved out of the home folder; the app's logs/ is the one place for the site, worker and seal logs.
# Both are anchored so they never swallow a same-named folder deeper in the tree (docs/archive/, vq2/lettering/archive/).
/archive/
/bbrose_design_os/logs/

# The app folder's own ignore lines, merged here by the clean-up of 2026-10-04 (one .gitignore). Each keeps the
# reach it had in bbrose_design_os/.gitignore: a path pattern anchored at the app folder, a bare name at any depth
# below it. History of why each line exists: that file in git history (commit before this one).
/bbrose_design_os/vendor/fonts/

# PALT-M4B-A render intermediates (regenerated by palt_m4b_a_evidence)
/bbrose_design_os/docs/roadmap/palt_m4b_a/_obj/
/bbrose_design_os/docs/roadmap/palt_m4b_a2/_obj/
/bbrose_design_os/docs/roadmap/palt_m4b_a3/_obj/
/bbrose_design_os/docs/roadmap/palt_m4b_a3p/evidence/_obj/
/bbrose_design_os/docs/roadmap/palt_m4c/variant_proof/_obj/
bbrose_design_os/**/_region_mask*.json
/bbrose_design_os/docs/roadmap/palt_m6/independence_sweeps/frames/*.exr
/bbrose_design_os/docs/roadmap/palt_m6/independence_sweeps/frames/*.png
/bbrose_design_os/docs/roadmap/palt_m6/contract_repair/bitfix_*/*.exr
/bbrose_design_os/docs/roadmap/palt_m6/contract_repair/bitfix_*/*.png
bbrose_design_os/**/.suite_gate_result
