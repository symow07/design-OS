bbrose_design_os/**/.record_regen_candidates.json
# WI-3H added the reserved-copy stage to guarded_commit.sh (line 150) and
# left its scratch file untracked-but-unignored, alone among the six
# artifacts that path writes. Scratch that shows up in `git status` is
# scratch that eventually gets committed by a `git add -A` nobody meant.
bbrose_design_os/**/.reserved_copy_output
# §AV5 added the brand-strings stage directly beneath that one and repeated
# the identical omission, with the warning above already written and three
# lines from the change. A recorded defect is not a control; the only thing
# that would have caught it is `git status` being read before committing,
# which is what did catch it.
bbrose_design_os/**/.brand_strings_output
bbrose_design_os/**/.brain_rebuild_output

# Owner-requested immutable local audit snapshot, including private DB and copied runtime.
/docs/audit/codex-2026-10-18/
/docs/audit/rescue_runtime/
/docs/brand/house_references/files/*
!/docs/brand/house_references/files/.gitkeep

/bbrose_design_os/var/rescue_spend/
/docs/rounds/.breaks.lock
