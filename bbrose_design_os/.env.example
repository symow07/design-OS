SECRET_KEY=
DEBUG=True
DATABASE_URL=postgresql://user:password@localhost:5432/bbrose_db
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=media/
# §BH54(i): the username explorations are served to; unset = served to nobody
OWNER_ACCOUNT=

# Ops / security (Milestone 14.1). Security hardening auto-activates when
# DEBUG=False; these tune it. Sentry is off unless SENTRY_DSN is set.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Static: set True in prod (after collectstatic) for hashed/compressed assets.
USE_MANIFEST_STATIC=False

# Celery run mode (Milestone 8.7). true = tasks run in-process (demo mode, no
# Redis/worker needed). false = enqueue to Redis; requires `celery -A config
# worker` (task creation and /healthz verify a worker is alive).
# Defaults to the value of DEBUG when unset.
CELERY_EAGER=

# Media storage (Milestone 8.1): "local" (authenticated /files/ route) or "s3"
# (private bucket + signed URLs, 1h expiry). S3 needs the AWS_* keys below.
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI models (Milestone 8.5) — override to swap models without a deploy.
CLAUDE_MODEL_HEAVY=claude-opus-4-7
CLAUDE_MODEL_FAST=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=180
# gpt-image family (dall-e-3 retired 2026): sizes 1024x1024|1024x1536|1536x1024,
# quality low|medium|high|auto. Base64 responses handled by the image producer.
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536

# Cost ledger & budget controls (Milestone 12.2). Prices for Claude models are
# fixed in settings.CLAUDE_PRICES; these override the image price and the caps.
# Set a cap to 0 to disable that guard.
# the image model at high/1024x1536 ≈ 0.25; medium ≈ 0.06; low ≈ 0.02
IMAGE_PRICE_PER_IMAGE=0.25
# Celery limits: a full pipeline run (3 gpt-image "high" renders + Claude
# stages + revisions) can pass 10 min; soft fires 60s before the hard kill.
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1740
MAX_COST_PER_TASK=5.0
MAX_COST_PER_DAY=100.0

# Notifications (Milestone 12.4). Dev prints emails to the log (console
# backend). For real email set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# plus the EMAIL_HOST_* values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bbrose.design
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
NOTIFICATION_BASE_URL=http://localhost:8000

# Owner and environment. ENVIRONMENT is this instance's own declaration of what it
# is (LOCAL_DEVELOPMENT, PRODUCTION, …), never inferred from DEBUG; UNCLASSIFIED when
# unset. The bootstrap ceremonies are off unless deliberately switched on, and the
# single-operator one runs only against a database named here.
ENVIRONMENT=UNCLASSIFIED
BOOTSTRAP_ENABLED=false
BOOTSTRAP_BREAK_GLASS_ENABLED=false
BOOTSTRAP_SINGLE_OPERATOR_ENABLED=false
LOCAL_DEVELOPMENT_DATABASES=bbrose_db
# Decision-event signing keys (DIP-1A). Unset, no decision event can be created and
# a system check says so (an error in production, a warning in development).
DECISION_EVENT_HMAC_KEYS=
DECISION_EVENT_ACTIVE_KEY_ID=

# Database transport (see config/settings.py): GSS encryption and TLS are set
# independently; a shared deployment states both deliberately.
DB_GSSENCMODE=
DB_SSLMODE=

# The design run's paid steps — each is one switch, on by default (pytest turns
# them off). The concept's design map is read once per picture at the shape step;
# product inference grounds a task without a Product record; the back panel is
# translated to Spanish and Arabic at the size step; a run may open a governed
# inspiration search (up to four Tavily searches).
DESIGN_MAP_READ=true
PRODUCT_INFERENCE=true
PANEL_TRANSLATE_ENABLED=true
WEB_INSPIRATION_IN_GENERATION=true
BRAND_MARK_APPROVAL_LOOKUP=true
# Concept pictures are made at high quality (his ruling of 2026-09-21); one revision
# pass at most; up to four past designs are shown to the planner; QA scoring uses
# CLAUDE_MODEL_FAST when QA_VISION_MODEL is empty.
IMAGE_QUALITY_CONCEPTS=high
MAX_REVISION_PASSES=1
MAX_DESIGN_REFERENCES=4
QA_VISION_MODEL=
# The house logo shown to the planner and placed as the mark. Unset, it is
# MEDIA_ROOT/brand/logo.png — leave the line commented unless the logo lives elsewhere.
# BRAND_LOGO_PATH=
# The regeneration page's mode: dry_run checks the whole path and makes nothing; live
# makes the pictures.
GATE1_REGENERATION_MODE=dry_run

# Web research and the trend board. No provider configured → research reports
# WEB_RESEARCH_NOT_CONFIGURED, never an uncontrolled fallback.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
TAVILY_USD_PER_CREDIT=0.008
WEB_QUARANTINE_ROOT=
# WEB_RESEARCH_USER_AGENT=   (unset: the settings' own research-bot name)
TREND_FETCH_BUDGET_S=90
TREND_REVIEW_WINDOW_S=120

# Print output intent for the production PDF. Which CMYK profile is the print shop's
# decision, so there is no default profile: unset, Gate 2 reports MISSING_OUTPUT_INTENT.
PRODUCTION_ICC_PROFILE_PATH=
PRODUCTION_OUTPUT_CONDITION=FOGRA39
PRODUCTION_OUTPUT_REGISTRY=http://www.color.org
